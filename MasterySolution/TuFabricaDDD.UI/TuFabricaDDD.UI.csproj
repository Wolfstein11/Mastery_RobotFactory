<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Add project references to domain and contracts if you want to use domain types in the UI -->
  <ItemGroup>
    <ProjectReference Include="..\TuFabricaDDD.Domain\TuFabricaDDD.Domain.csproj" />
    <ProjectReference Include="..\TuFabricaDDD.Contracts\TuFabricaDDD.Contracts.csproj" />
    <ProjectReference Include="..\TuFabricaDDD.GrpcContracts\TuFabricaDDD.GrpcContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Google.Protobuf" Version="3.30.2" />
    <PackageReference Include="Grpc.Tools" Version="2.71.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
